{
  "name": "isolmass-share",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  "r2_buckets": [{ "binding": "IMAGES" }],
  "d1_databases": [{ "binding": "DB", "database_name": "isolmass-share" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "secrets": { "required": ["UPLOAD_TOKEN", "ADMIN_TOKEN"] },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
