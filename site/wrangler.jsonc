{
  "name": "isolmass-site",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "ss.isolmaz.com", "custom_domain": true }],
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
